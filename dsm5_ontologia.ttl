        owl:NamedIndividual ;
    rdfs:label "Mild:** 4--5 criteria met."@en .

dsm5:Gambling_Disorder__Severity_1 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Moderate:** 6--7 criteria met."@en .

dsm5:Gambling_Disorder__Severity_2 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Severe:** 8--9 criteria met."@en .

dsm5:Gender_Dysphoria_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Gender Dysphoria — Criterion A"@en ;
    med:hasMinimumSymptomCount 6 ;
    med:hasRequiredDuration "P6M"^^xsd:duration ;
    med:hasSymptom dsm5:Gender_Dysphoria_Criterion_A__HP_0000062 ;
    rdfs:comment "A marked incongruence between one's experienced/expressed gender and assigned gender, of at least 6 months' duration, as manifested by at least six of the following (one of which must be Criterion A1) A strong desire to be of the other gender or an insistence that one is the other gender (or some alternative gender different from one's assigned gender). In boys (assigned gender), a strong preference for cross-dressing or simulating female attire; or in girls (assigned gender), a strong preference for wearing only typical masculine clothing and a strong resistance to the wearing of typical feminine clothing. A strong preference for cross-gender roles in make-believe play or fantasy play. A strong preference for the toys, games, or activities stereotypically used or engaged in by the other gender. A strong preference for playmates of the other gender. In boys (assigned gender), a strong rejection of typically masculine toys, games, and activities and a strong avoidance of rough-and-tumble play; or in girls (assigned gender), a strong rejection of typically feminine toys, games, and activities. A strong dislike of one's sexual anatomy. A strong desire for the primary and/or secondary sex characteristics that match one's experienced gender."@en .

dsm5:Gender_Dysphoria_Criterion_A__HP_0000062 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Ambiguous genitalia"@en ;
    dsm5:confidence 0.8 ;
