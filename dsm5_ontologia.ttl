dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0007334 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Bilateral tonic-clonic seizure with focal onset"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0007334 ;
