dsm5:Male_Hypoactive_Sexual_Desire_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Male Hypoactive Sexual Desire Disorder — Criterion D"@en ;
    rdfs:comment "The sexual dysfunction is not better explained by a nonsexual mental disorder or as a consequence of severe relationship distress or other significant stressors and is not attributable to the effects of a substance/medication or another medical condition"@en .

dsm5:Male_Hypoactive_Sexual_Desire_Disorder__Severity_0 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Mild:** Evidence of mild distress over the symptoms in Criterion A."@en .

dsm5:Male_Hypoactive_Sexual_Desire_Disorder__Severity_1 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Moderate:** Evidence of moderate distress over the symptoms in"@en .

dsm5:Male_Hypoactive_Sexual_Desire_Disorder__Severity_2 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
