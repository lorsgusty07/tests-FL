    skos:prefLabel "Speech Sound Disorder"@en .

dsm5:Stereotypic_Movement_Disorder a owl:Class ;
    rdfs:label "Stereotypic Movement Disorder"@en ;
    med:hasCriterion dsm5:Stereotypic_Movement_Disorder_Criterion_A,
        dsm5:Stereotypic_Movement_Disorder_Criterion_B,
        dsm5:Stereotypic_Movement_Disorder_Criterion_C,
        dsm5:Stereotypic_Movement_Disorder_Criterion_D ;
    med:hasSeverityLevel dsm5:Stereotypic_Movement_Disorder__Severity_0,
        dsm5:Stereotypic_Movement_Disorder__Severity_1,
        dsm5:Stereotypic_Movement_Disorder__Severity_2 ;
    med:hasSpecifierText """The severity of non-self-injurious stereotypic movements ranges from
mild presentations that are easily suppressed by a sensory stimulus or
distraction to continuous movements that markedly interfere with all
activities of daily living. Self-injurious behaviors range in severity
along various dimensions, including the frequency, impact on adaptive
functioning, and severity of bodily injury (from mild bruising or
erythema from hitting hand against body, to lacerations or amputation of
digits, to retinal detachment from head banging)."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Stereotypic Movement Disorder"@en .

dsm5:Stimulant_Intoxication a owl:Class ;
    rdfs:label "Stimulant Intoxication"@en ;
    med:hasCriterion dsm5:Stimulant_Intoxication_Criterion_A,
        dsm5:Stimulant_Intoxication_Criterion_B,
        dsm5:Stimulant_Intoxication_Criterion_C,
