        dsm5:Anorexia_Nervosa__Severity_2 ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Anorexia Nervosa"@en .

dsm5:Antisocial_Personality_Disorder a owl:Class ;
