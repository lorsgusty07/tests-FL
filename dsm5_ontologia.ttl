@prefix dsm5: <http://example.org/dsm5/> .
@prefix hpo: <http://purl.obolibrary.org/obo/> .
@prefix med: <http://example.org/medical/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/dsm5> a owl:Ontology ;
    rdfs:label "DSM-5 Diagnostic Criteria & HPO Ontology"@en ;
    owl:versionInfo "1.0"^^xsd:string .

dsm5:Acute_Stress_Disorder a owl:Class ;
    rdfs:label "Acute Stress Disorder"@en ;
    med:hasCriterion dsm5:Acute_Stress_Disorder_Criterion_A,
        dsm5:Acute_Stress_Disorder_Criterion_B,
        dsm5:Acute_Stress_Disorder_Criterion_C,
        dsm5:Acute_Stress_Disorder_Criterion_D,
        dsm5:Acute_Stress_Disorder_Criterion_E ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Acute Stress Disorder"@en .

dsm5:Adjustment_Disorders a owl:Class ;
    rdfs:label "Adjustment Disorders"@en ;
    med:hasCriterion dsm5:Adjustment_Disorders_Criterion_A,
        dsm5:Adjustment_Disorders_Criterion_B,
        dsm5:Adjustment_Disorders_Criterion_C,
        dsm5:Adjustment_Disorders_Criterion_D,
        dsm5:Adjustment_Disorders_Criterion_E ;
    med:hasSpecifierText """By definition, an adjustment disorder must resolve within 6 months of
the termination of the stressor or its consequences. However, the
symptoms may persist for a prolonged period (i.e., longer than 6 months)
if they occur in response to a persistent stressor (e.g., a chronic
disabling other medical condition) or to a stressor that has enduring
consequences (e.g., the financial and emotional difficulties resulting
from a divorce). The duration of the symptoms of an adjustment disorder
can be indicated by using the acute or persistent (chronic) specifiers.
The acute specifier is used to indicate persistence of symptoms for less
than 6 months. The persistent (chronic) specifier is used to indicate
persistence of symptoms for 6 months or longer. This latter specifier
therefore applies when the duration of the disturbance is longer than 6
months in response to a persistent stressor or to a stressor that has
enduring consequences."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Adjustment Disorders"@en .

dsm5:Agoraphobia a owl:Class ;
    rdfs:label "Agoraphobia"@en ;
    med:hasCriterion dsm5:Agoraphobia_Criterion_A,
        dsm5:Agoraphobia_Criterion_B,
        dsm5:Agoraphobia_Criterion_C,
        dsm5:Agoraphobia_Criterion_D,
        dsm5:Agoraphobia_Criterion_E,
        dsm5:Agoraphobia_Criterion_F,
        dsm5:Agoraphobia_Criterion_G,
        dsm5:Agoraphobia_Criterion_H,
        dsm5:Agoraphobia_Criterion_I ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Agoraphobia"@en .

dsm5:Alcohol_Intoxication a owl:Class ;
    rdfs:label "Alcohol Intoxication"@en ;
    med:hasCriterion dsm5:Alcohol_Intoxication_Criterion_A,
        dsm5:Alcohol_Intoxication_Criterion_B,
        dsm5:Alcohol_Intoxication_Criterion_C,
        dsm5:Alcohol_Intoxication_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Alcohol Intoxication"@en .

dsm5:Alcohol_Use_Disorder a owl:Class ;
    rdfs:label "Alcohol Use Disorder"@en ;
    med:hasCriterion dsm5:Alcohol_Use_Disorder_Criterion_A ;
    med:hasSeverityLevel dsm5:Alcohol_Use_Disorder__Severity_0,
        dsm5:Alcohol_Use_Disorder__Severity_1,
        dsm5:Alcohol_Use_Disorder__Severity_2 ;
    med:hasSpecifierText """"In a controlled environment" applies as a further specifier of
remission if the individual is both in remission and in a controlled
environment (i.e., in early remission in a controlled environment or in
sustained remission in a controlled environment). Examples of these
environments are closely supervised and substance-free jails,
therapeutic communities, and locked hospital units.

Severity of the disorder is based on the number of diagnostic criteria
endorsed. For a given individual, changes in severity of alcohol use
disorder across time are also reflected by reductions in the frequency
(e.g., days of use per month) or dose (e.g., number of standard drinks
consumed per day) of alcohol used, as assessed by the individual's
self-report, report of knowledgeable others, clinician observations,
and, when practical, biological testing (e.g., elevations in blood tests
as described in the section "Diagnostic Markers" for this disorder)."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Alcohol Use Disorder"@en .

dsm5:Alcohol_Withdrawal a owl:Class ;
    rdfs:label "Alcohol Withdrawal"@en ;
    med:hasCriterion dsm5:Alcohol_Withdrawal_Criterion_A,
        dsm5:Alcohol_Withdrawal_Criterion_B,
        dsm5:Alcohol_Withdrawal_Criterion_C,
        dsm5:Alcohol_Withdrawal_Criterion_D ;
    med:hasSpecifierText """When hallucinations occur in the absence of delirium (i.e., in a clear
sensorium), a diagnosis of substance/medication-induced psychotic
disorder should be considered."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Alcohol Withdrawal"@en .

dsm5:Anorexia_Nervosa a owl:Class ;
    rdfs:label "Anorexia Nervosa"@en ;
    med:hasCriterion dsm5:Anorexia_Nervosa_Criterion_A,
        dsm5:Anorexia_Nervosa_Criterion_B,
