        owl:NamedIndividual ;
    rdfs:label "Language Disorder — Criterion C"@en ;
    rdfs:comment "Onset of symptoms is in the early developmental period"@en .

dsm5:Language_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
