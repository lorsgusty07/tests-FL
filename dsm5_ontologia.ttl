        dsm5:Substance_Medication_Induced_Sexual_Dysfunction_Criterion_B,
        dsm5:Substance_Medication_Induced_Sexual_Dysfunction_Criterion_C,
        dsm5:Substance_Medication_Induced_Sexual_Dysfunction_Criterion_D,
        dsm5:Substance_Medication_Induced_Sexual_Dysfunction_Criterion_E ;
    med:hasSeverityLevel dsm5:Substance_Medication_Induced_Sexual_Dysfunction__Severity_0,
        dsm5:Substance_Medication_Induced_Sexual_Dysfunction__Severity_1,
        dsm5:Substance_Medication_Induced_Sexual_Dysfunction__Severity_2 ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Substance/Medication-Induced Sexual Dysfunction"@en .

dsm5:Substance_Medication_Induced_Sleep_Disorder a owl:Class ;
    rdfs:label "Substance/Medication-Induced Sleep Disorder"@en ;
    med:hasCriterion dsm5:Substance_Medication_Induced_Sleep_Disorder_Criterion_A,
        dsm5:Substance_Medication_Induced_Sleep_Disorder_Criterion_B,
        dsm5:Substance_Medication_Induced_Sleep_Disorder_Criterion_C,
        dsm5:Substance_Medication_Induced_Sleep_Disorder_Criterion_D,
        dsm5:Substance_Medication_Induced_Sleep_Disorder_Criterion_E ;
    med:hasSpecifierText """Depending on the substance involved, one of four types of sleep
disturbances is indicated. Insomnia type and daytime sleepiness type are
most common, whereas parasomnia type is seen less often. The mixed type
is noted when more than one type of sleep disturbance--related symptom
is present and none predominates."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Substance/Medication-Induced Sleep Disorder"@en .

dsm5:Tobacco_Use_Disorder a owl:Class ;
    rdfs:label "Tobacco Use Disorder"@en ;
    med:hasCriterion dsm5:Tobacco_Use_Disorder_Criterion_A ;
    med:hasSeverityLevel dsm5:Tobacco_Use_Disorder__Severity_0,
        dsm5:Tobacco_Use_Disorder__Severity_1 ;
    med:hasSpecifierText """"On maintenance therapy" applies as a specifier to be added to "in
remission" if the individual is both in remission and on maintenance
therapy. "In a controlled environment" applies as a further specifier of
remission if the individual is both in remission and in a controlled
environment (i.e., in early remission in a controlled environment or in
sustained remission in a controlled environment). Examples of these
environments are closely supervised and substance-free jails,
therapeutic communities, and locked hospital units."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Tobacco Use Disorder"@en .

dsm5:Tobacco_Withdrawal a owl:Class ;
    rdfs:label "Tobacco Withdrawal"@en ;
    med:hasCriterion dsm5:Tobacco_Withdrawal_Criterion_A,
        dsm5:Tobacco_Withdrawal_Criterion_B,
        dsm5:Tobacco_Withdrawal_Criterion_C,
        dsm5:Tobacco_Withdrawal_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Tobacco Withdrawal"@en .

dsm5:Transvestic_Disorder a owl:Class ;
    rdfs:label "Transvestic Disorder"@en ;
    med:hasCriterion dsm5:Transvestic_Disorder_Criterion_A,
        dsm5:Transvestic_Disorder_Criterion_B ;
    med:hasSpecifierText """The presence of fetishism decreases the likelihood of gender dysphoria
in men with transvestic disorder. The presence of autogynephilia
increases the likelihood of gender dysphoria in men with transvestic
disorder."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Transvestic Disorder"@en .

dsm5:Trichotillomania_Hair_Pulling_Disorder a owl:Class ;
    rdfs:label "Trichotillomania (Hair-Pulling Disorder)"@en ;
    med:hasCriterion dsm5:Trichotillomania_Hair_Pulling_Disorder_Criterion_A,
        dsm5:Trichotillomania_Hair_Pulling_Disorder_Criterion_B,
        dsm5:Trichotillomania_Hair_Pulling_Disorder_Criterion_C,
        dsm5:Trichotillomania_Hair_Pulling_Disorder_Criterion_D,
        dsm5:Trichotillomania_Hair_Pulling_Disorder_Criterion_E ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Trichotillomania (Hair-Pulling Disorder)"@en .

dsm5:Voyeuristic_Disorder a owl:Class ;
    rdfs:label "Voyeuristic Disorder"@en ;
    med:hasCriterion dsm5:Voyeuristic_Disorder_Criterion_A,
        dsm5:Voyeuristic_Disorder_Criterion_B,
        dsm5:Voyeuristic_Disorder_Criterion_C ;
    med:hasSpecifierText """The "in full remission" specifier does not address the continued
presence or absence of voyeurism per se, which may still be present
after behaviors and distress have remitted."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Voyeuristic Disorder"@en .

dsm5:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:range xsd:decimal .

dsm5:icd10Code a owl:DatatypeProperty ;
    rdfs:label "icd10Code"@en ;
    rdfs:range xsd:string .

med:hasCriterion a owl:ObjectProperty ;
    rdfs:label "hasCriterion"@en ;
    rdfs:domain dsm5:MentalDisorder ;
    rdfs:range dsm5:DiagnosticCriterion .

med:hasMinimumSymptomCount a owl:DatatypeProperty ;
    rdfs:label "hasMinimumSymptomCount"@en ;
    rdfs:domain dsm5:DiagnosticCriterion ;
    rdfs:range xsd:integer .

med:hasRequiredDuration a owl:DatatypeProperty ;
    rdfs:label "hasRequiredDuration"@en ;
    rdfs:domain dsm5:DiagnosticCriterion ;
    rdfs:range xsd:duration .

med:hasSeverityLevel a owl:ObjectProperty ;
    rdfs:label "hasSeverityLevel"@en ;
    rdfs:domain dsm5:MentalDisorder ;
    rdfs:range dsm5:SeverityLevel .

med:hasSpecifier a owl:ObjectProperty ;
    rdfs:label "hasSpecifier"@en ;
    rdfs:domain dsm5:MentalDisorder ;
    rdfs:range dsm5:Specifier .

med:hasSpecifierText a owl:DatatypeProperty ;
    rdfs:label "hasSpecifierText"@en ;
    rdfs:domain dsm5:MentalDisorder ;
    rdfs:range xsd:string .

med:hasSubtype a owl:ObjectProperty ;
    rdfs:label "hasSubtype"@en ;
    rdfs:domain dsm5:MentalDisorder ;
    rdfs:range dsm5:Subtype .

med:hasSymptom a owl:ObjectProperty ;
    rdfs:label "hasSymptom"@en ;
    rdfs:domain dsm5:DiagnosticCriterion ;
    rdfs:range dsm5:Symptom .

med:mapsToHPO a owl:ObjectProperty ;
    rdfs:label "mapsToHPO"@en ;
    rdfs:domain dsm5:Symptom ;
    rdfs:range owl:Thing .

dsm5:Acute_Stress_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Acute Stress Disorder — Criterion A"@en ;
    med:hasMinimumSymptomCount 1 ;
    med:hasSymptom dsm5:Acute_Stress_Disorder_Criterion_A__HP_0032316,
        dsm5:Acute_Stress_Disorder_Criterion_A__HP_0032942 ;
    rdfs:comment "Exposure to actual or threatened death, serious injury, or sexual violence in one (or more) of the following ways Directly experiencing the traumatic event(s). Witnessing, in person, the event(s) as it occurred to others. Learning that the event(s) occurred to a close family member or close friend. **Note:** In cases of actual or threatened death of a family member or friend, the event(s) must have been violent or accidental. Experiencing repeated or extreme exposure to aversive details of the traumatic event(s) (e.g., first responders collecting human remains, police officers repeatedly exposed to details of child abuse). **Note:** This does not apply to exposure through electronic media, television, movies, or pictures, unless this exposure is work related."@en .

dsm5:Acute_Stress_Disorder_Criterion_A__HP_0032316 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Family history"@en ;
    dsm5:confidence 0.8 ;
    med:mapsToHPO hpo:HP_0032316 ;
    rdfs:comment "The phrase refers to learning about traumatic events affecting close family members or friends, which relates to family history."@en .

dsm5:Acute_Stress_Disorder_Criterion_A__HP_0032942 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Avoidance of stimuli associated with traumatic event"@en ;
    dsm5:confidence 0.8 ;
    med:mapsToHPO hpo:HP_0032942 ;
    rdfs:comment "The phrase relates to witnessing traumatic events, which aligns with avoidance of stimuli associated with traumatic events."@en .

dsm5:Acute_Stress_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Acute Stress Disorder — Criterion B"@en ;
    med:hasMinimumSymptomCount 9 ;
    med:hasSymptom dsm5:Acute_Stress_Disorder_Criterion_B__HP_0002267,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0002354,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0002360,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0030213,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0031987,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0032939,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0032940,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_0033676,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_5200104,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_5200231,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_5200273,
        dsm5:Acute_Stress_Disorder_Criterion_B__HP_5200423 ;
    rdfs:comment "Presence of nine (or more) of the following symptoms from any of the five categories of intrusion, negative mood, dissociation, avoidance, and arousal, beginning or worsening after the traumatic event(s) occurred: Intrusion Symptoms Recurrent, involuntary, and intrusive distressing memories of the traumatic event(s). **Note:** In children, repetitive play may occur in which themes or aspects of the traumatic event(s) are expressed. Recurrent distressing dreams in which the content and/or affect of the dream are related to the event(s). **Note:** In children, there may be frightening dreams without recognizable content. Dissociative reactions (e.g., flashbacks) in which the individual feels or acts as if the traumatic event(s) were recurring. (Such reactions may occur on a continuum, with the most extreme expression being a complete loss of awareness of present surroundings.) **Note:** In children, trauma-specific reenactment may occur in play. Intense or prolonged psychological distress or marked physiological reactions in response to internal or external cues that symbolize or resemble an aspect of the traumatic event(s). Negative Mood Persistent inability to experience positive emotions (e.g., inability to experience happiness, satisfaction, or loving feelings). **Dissociative Symptoms** An altered sense of the reality of one's surroundings or oneself (e.g., seeing oneself from another's perspective, being in a daze, time slowing). Inability to remember an important aspect of the traumatic event(s) (typically due to dissociative amnesia and not to other factors such as head injury, alcohol, or drugs). **Avoidance Symptoms** Efforts to avoid distressing memories, thoughts, or feelings about or closely associated with the traumatic event(s). Efforts to avoid external reminders (people, places, conversations, activities, objects, situations) that arouse distressing memories, thoughts, or feelings about or closely associated with the traumatic event(s). **Arousal Symptoms** Sleep disturbance (e.g., difficulty falling or staying asleep, restless sleep). Irritable behavior and angry outbursts (with little or no provocation), typically expressed as verbal or physical aggression toward people or objects. Hypervigilance. Problems with concentration. Exaggerated startle response."@en .

