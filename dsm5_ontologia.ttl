    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Bulimia Nervosa"@en .

dsm5:Caffeine_Intoxication a owl:Class ;
    rdfs:label "Caffeine Intoxication"@en ;
    med:hasCriterion dsm5:Caffeine_Intoxication_Criterion_A,
        dsm5:Caffeine_Intoxication_Criterion_B,
        dsm5:Caffeine_Intoxication_Criterion_C,
        dsm5:Caffeine_Intoxication_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Caffeine Intoxication"@en .

dsm5:Caffeine_Withdrawal a owl:Class ;
    rdfs:label "Caffeine Withdrawal"@en ;
    med:hasCriterion dsm5:Caffeine_Withdrawal_Criterion_A,
        dsm5:Caffeine_Withdrawal_Criterion_B,
        dsm5:Caffeine_Withdrawal_Criterion_C,
        dsm5:Caffeine_Withdrawal_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Caffeine Withdrawal"@en .

dsm5:Cannabis_Intoxication a owl:Class ;
    rdfs:label "Cannabis Intoxication"@en ;
    med:hasCriterion dsm5:Cannabis_Intoxication_Criterion_A,
        dsm5:Cannabis_Intoxication_Criterion_B,
        dsm5:Cannabis_Intoxication_Criterion_C,
        dsm5:Cannabis_Intoxication_Criterion_D ;
    med:hasSpecifierText """When hallucinations occur in the absence of intact reality testing, a
diagnosis of substance/medication-induced psychotic disorder should be
considered."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Cannabis Intoxication"@en .

dsm5:Cannabis_Use_Disorder a owl:Class ;
    rdfs:label "Cannabis Use Disorder"@en ;
    med:hasCriterion dsm5:Cannabis_Use_Disorder_Criterion_A ;
    med:hasSeverityLevel dsm5:Cannabis_Use_Disorder__Severity_0,
        dsm5:Cannabis_Use_Disorder__Severity_1,
        dsm5:Cannabis_Use_Disorder__Severity_2 ;
    med:hasSpecifierText """"In a controlled environment" applies as a further specifier of
remission if the individual is both in remission and in a controlled
environment (i.e., in early remission in a controlled environment or in
sustained remission in a controlled environment). Examples of these
environments are closely supervised and substance-free jails,
therapeutic communities, and locked hospital units.

Changing severity across time in an individual may also be reflected by
changes in the frequency (e.g., days of use per month or times used per
day) and/or dose (e.g., amount used per episode) of cannabis, as
assessed by individual self-report, report of knowledgeable others,
clinician's observations, and biological testing."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Cannabis Use Disorder"@en .

dsm5:Cannabis_Withdrawal a owl:Class ;
    rdfs:label "Cannabis Withdrawal"@en ;
    med:hasCriterion dsm5:Cannabis_Withdrawal_Criterion_A,
        dsm5:Cannabis_Withdrawal_Criterion_B,
        dsm5:Cannabis_Withdrawal_Criterion_C,
        dsm5:Cannabis_Withdrawal_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Cannabis Withdrawal"@en .

dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition a owl:Class ;
    rdfs:label "Catatonic Disorder Due to Another Medical Condition"@en ;
    med:hasCriterion dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition_Criterion_A,
        dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition_Criterion_B,
        dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition_Criterion_C,
        dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition_Criterion_D,
        dsm5:Catatonic_Disorder_Due_to_Another_Medical_Condition_Criterion_E ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Catatonic Disorder Due to Another Medical Condition"@en .

dsm5:Central_Sleep_Apnea a owl:Class ;
    rdfs:label "Central Sleep Apnea"@en ;
    med:hasCriterion dsm5:Central_Sleep_Apnea_Criterion_A,
        dsm5:Central_Sleep_Apnea_Criterion_B ;
    med:hasSpecifierText """An increase in the central apnea index (i.e., number of central apneas
per hour of sleep) reflects an increase in severity of central sleep
apnea. Sleep continuity and quality may be markedly impaired with
reductions in restorative stages of non--rapid eye movement (NREM) sleep
(i.e., decreased slow-wave sleep \\[stage N3\\]). In individuals with
severe Cheyne-Stokes breathing, the pattern can also be observed during
resting wakefulness, a finding that is thought to be a prognostic marker
for increased mortality."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Central Sleep Apnea"@en .

dsm5:Childhood_Onset_Fluency_Disorder_Stuttering a owl:Class ;
    rdfs:label "Childhood-Onset Fluency Disorder (Stuttering)"@en ;
    med:hasCriterion dsm5:Childhood_Onset_Fluency_Disorder_Stuttering_Criterion_A,
        dsm5:Childhood_Onset_Fluency_Disorder_Stuttering_Criterion_B,
        dsm5:Childhood_Onset_Fluency_Disorder_Stuttering_Criterion_C,
        dsm5:Childhood_Onset_Fluency_Disorder_Stuttering_Criterion_D ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Childhood-Onset Fluency Disorder (Stuttering)"@en .

dsm5:Circadian_Rhythm_Sleep_Wake_Disorders a owl:Class ;
    rdfs:label "Circadian Rhythm Sleep-Wake Disorders"@en ;
    med:hasCriterion dsm5:Circadian_Rhythm_Sleep_Wake_Disorders_Criterion_A,
        dsm5:Circadian_Rhythm_Sleep_Wake_Disorders_Criterion_B,
        dsm5:Circadian_Rhythm_Sleep_Wake_Disorders_Criterion_C ;
    med:hasSpecifierText """The presence of a family history of advanced sleep phase type may be
indicated with the specifier "familial." In the familial form, specific
mutations demonstrate an autosomal dominant mode of inheritance, the
course is persistent, and the severity of symptoms may increase with
age. The prevalence of familial advanced sleep phase type has not been
established."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Circadian Rhythm Sleep-Wake Disorders"@en .

dsm5:Conduct_Disorder a owl:Class ;
    rdfs:label "Conduct Disorder"@en ;
    med:hasCriterion dsm5:Conduct_Disorder_Criterion_A,
        dsm5:Conduct_Disorder_Criterion_B,
        dsm5:Conduct_Disorder_Criterion_C ;
    med:hasSeverityLevel dsm5:Conduct_Disorder__Severity_0,
        dsm5:Conduct_Disorder__Severity_1,
        dsm5:Conduct_Disorder__Severity_2 ;
    med:hasSpecifierText """A minority of individuals with conduct disorder exhibit characteristics
that qualify for the "with limited prosocial emotions" specifier. The
indicators of this specifier are those that have often been labeled as
callous and unemotional traits in research. Other personality features,
such as thrill seeking, fearlessness, and insensitivity to punishment,
may also distinguish those with characteristics described in the
specifier. Individuals with characteristics described in this specifier
may be more likely than other individuals with conduct disorder to
engage in aggression that is planned for instrumental gain. Individuals
with conduct disorder of any subtype or any level of severity can have
characteristics that qualify for the specifier "with limited prosocial
emotions," although individuals with the specifier are more likely to
have childhood-onset type and a severity specifier rating of severe.

Although the validity of self-report to assess the presence of the
specifier has been supported in some research contexts, individuals with
conduct disorder with this specifier may not readily admit to the traits
in a clinical interview. Thus, to assess the criteria for the specifier,
multiple information sources are necessary. Also, because the indicators
of the specifier are characteristics that reflect the individual's
typical pattern of interpersonal and emotional functioning, it is
important to consider reports by others who have known the individual
for extended periods of time and across relationships and settings
(e.g., parents, teachers, co-workers, extended family members, peers)."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Conduct Disorder"@en .

dsm5:Cyclothymic_Disorder a owl:Class ;
    rdfs:label "Cyclothymic Disorder"@en ;
