dsm5:Non_Rapid_Eye_Movement_Sleep_Arousal_Disorders_Criterion_E a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Non--Rapid Eye Movement Sleep Arousal Disorders — Criterion E"@en ;
    rdfs:comment "The disturbance is not attributable to the physiological effects of a substance (e.g., a drug of abuse, a medication)"@en .

dsm5:Non_Rapid_Eye_Movement_Sleep_Arousal_Disorders_Criterion_F a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Non--Rapid Eye Movement Sleep Arousal Disorders — Criterion F"@en ;
