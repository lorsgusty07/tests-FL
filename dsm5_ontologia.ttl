dsm5:Social_Anxiety_Disorder a owl:Class ;
    rdfs:label "Social Anxiety Disorder"@en ;
    med:hasCriterion dsm5:Social_Anxiety_Disorder_Criterion_A,
        dsm5:Social_Anxiety_Disorder_Criterion_B,
        dsm5:Social_Anxiety_Disorder_Criterion_C,
        dsm5:Social_Anxiety_Disorder_Criterion_D,
        dsm5:Social_Anxiety_Disorder_Criterion_E,
        dsm5:Social_Anxiety_Disorder_Criterion_F,
        dsm5:Social_Anxiety_Disorder_Criterion_G,
        dsm5:Social_Anxiety_Disorder_Criterion_H,
        dsm5:Social_Anxiety_Disorder_Criterion_I,
        dsm5:Social_Anxiety_Disorder_Criterion_J ;
    med:hasSpecifierText """Individuals with the performance only type of social anxiety disorder
have performance fears that are typically most impairing in their
professional lives (e.g., musicians, dancers, performers, athletes) or
in roles that require regular public speaking. Performance fears may
also manifest in work, school, or academic settings in which regular
public presentations are required. Individuals with performance only
social anxiety disorder do not fear or avoid nonperformance social
situations."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Social Anxiety Disorder"@en .

dsm5:Social_Pragmatic_Communication_Disorder a owl:Class ;
    rdfs:label "Social (Pragmatic) Communication Disorder"@en ;
    med:hasCriterion dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A,
        dsm5:Social_Pragmatic_Communication_Disorder_Criterion_B,
