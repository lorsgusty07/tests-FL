    skos:prefLabel "Specific Learning Disorder"@en .

dsm5:Specific_Phobia a owl:Class ;
    rdfs:label "Specific Phobia"@en ;
    med:hasCriterion dsm5:Specific_Phobia_Criterion_A,
        dsm5:Specific_Phobia_Criterion_B,
        dsm5:Specific_Phobia_Criterion_C,
        dsm5:Specific_Phobia_Criterion_D,
        dsm5:Specific_Phobia_Criterion_E,
        dsm5:Specific_Phobia_Criterion_F,
        dsm5:Specific_Phobia_Criterion_G ;
    med:hasSpecifierText """It is common for individuals to have multiple specific phobias. The
average individual with specific phobia fears three objects or
situations, and approximately 75% of individuals with specific phobia
fear more than one situation or object. In such cases, multiple specific
phobia diagnoses, each with its own diagnostic code reflecting the
phobic stimulus, would need to be given. For example, if an individual
fears thunderstorms and flying, then two diagnoses would be given:
specific phobia, natural environment, and specific phobia, situational."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Specific Phobia"@en .

dsm5:Speech_Sound_Disorder a owl:Class ;
    rdfs:label "Speech Sound Disorder"@en ;
    med:hasCriterion dsm5:Speech_Sound_Disorder_Criterion_A,
        dsm5:Speech_Sound_Disorder_Criterion_B,
        dsm5:Speech_Sound_Disorder_Criterion_C,
        dsm5:Speech_Sound_Disorder_Criterion_D ;
