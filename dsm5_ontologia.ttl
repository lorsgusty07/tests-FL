        owl:NamedIndividual ;
    rdfs:label "Personality Change Due to Another Medical Condition — Criterion B"@en ;
    rdfs:comment "There is evidence from the history, physical examination, or laboratory findings that the disturbance is the direct pathophysiological consequence of another medical condition"@en .

dsm5:Personality_Change_Due_to_Another_Medical_Condition_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Personality Change Due to Another Medical Condition — Criterion C"@en ;
