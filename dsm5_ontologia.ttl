    med:mapsToHPO hpo:HP_0001649 ;
    rdfs:comment "Tachycardia is explicitly mentioned in the clinical phrase and matches the HPO term."@en .

dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0002063 a dsm5:Symptom,
