dsm5:Reactive_Attachment_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Reactive Attachment Disorder — Criterion A"@en ;
    rdfs:comment "A consistent pattern of inhibited, emotionally withdrawn behavior toward adult caregivers, manifested by both of the following The child rarely or minimally seeks comfort when distressed. The child rarely or minimally responds to comfort when distressed."@en .

dsm5:Reactive_Attachment_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Reactive Attachment Disorder — Criterion B"@en ;
    med:hasMinimumSymptomCount 2 ;
    med:hasSymptom dsm5:Reactive_Attachment_Disorder_Criterion_B__HP_0030213 ;
    rdfs:comment "A persistent social and emotional disturbance characterized by at least two of the following Minimal social and emotional responsiveness to others. Limited positive affect. Episodes of unexplained irritability, sadness, or fearfulness that are evident even during nonthreatening interactions with adult caregivers."@en .

dsm5:Reactive_Attachment_Disorder_Criterion_B__HP_0030213 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Emotional dearth"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0030213 ;
