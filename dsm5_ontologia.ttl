dsm5:Avoidant_Personality_Disorder_Criterion_G a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Avoidant Personality Disorder — Criterion G"@en ;
    rdfs:comment "Is unusually reluctant to take personal risks or to engage in any new activities because they may prove embarrassing"@en .

dsm5:Avoidant_Restrictive_Food_Intake_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Avoidant/Restrictive Food Intake Disorder — Criterion A"@en ;
    med:hasMinimumSymptomCount 1 ;
    med:hasSymptom dsm5:Avoidant_Restrictive_Food_Intake_Disorder_Criterion_A__HP_0001824,
        dsm5:Avoidant_Restrictive_Food_Intake_Disorder_Criterion_A__HP_0025156 ;
    rdfs:comment "An eating or feeding disturbance (e.g., apparent lack of interest in eating or food; avoidance based on the sensory characteristics of food; concern about aversive consequences of eating) associated with one (or more) of the following Significant weight loss (or failure to achieve expected weight gain or faltering growth in children). Significant nutritional deficiency. Dependence on enteral feeding or oral nutritional supplements. Marked interference with psychosocial functioning."@en .

dsm5:Avoidant_Restrictive_Food_Intake_Disorder_Criterion_A__HP_0001824 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Weight loss"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0001824 ;
    rdfs:comment "The phrase directly describes significant weight loss, which corresponds to the HPO term for weight loss."@en .

dsm5:Avoidant_Restrictive_Food_Intake_Disorder_Criterion_A__HP_0025156 a dsm5:Symptom,
