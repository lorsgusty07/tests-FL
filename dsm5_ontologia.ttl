        dsm5:Borderline_Personality_Disorder_Criterion_G,
        dsm5:Borderline_Personality_Disorder_Criterion_H,
        dsm5:Borderline_Personality_Disorder_Criterion_I ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Borderline Personality Disorder"@en .

