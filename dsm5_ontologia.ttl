dsm5:Female_Sexual_Interest_Arousal_Disorder a owl:Class ;
    rdfs:label "Female Sexual Interest/Arousal Disorder"@en ;
    med:hasCriterion dsm5:Female_Sexual_Interest_Arousal_Disorder_Criterion_A,
        dsm5:Female_Sexual_Interest_Arousal_Disorder_Criterion_B,
