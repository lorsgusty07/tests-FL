dsm5:Phencyclidine_Intoxication_Criterion_C__HP_5200213 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Diminishment of emotional responsiveness"@en ;
    dsm5:confidence 0.8 ;
