dsm5:Dissociative_Amnesia a owl:Class ;
    rdfs:label "Dissociative Amnesia"@en ;
    med:hasCriterion dsm5:Dissociative_Amnesia_Criterion_A,
        dsm5:Dissociative_Amnesia_Criterion_B,
        dsm5:Dissociative_Amnesia_Criterion_C,
        dsm5:Dissociative_Amnesia_Criterion_D ;
    med:hasSpecifierText """The specifier "with dissociative fugue" applies when dissociative
amnesia occurs in the context of a dissociative fugue, which is
characterized by apparently purposeful travel or bewildered wandering
that is associated with amnesia for identity or other important
autobiographical information."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Dissociative Amnesia"@en .

