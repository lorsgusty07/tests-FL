dsm5:Tobacco_Withdrawal_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Tobacco Withdrawal — Criterion B"@en ;
    med:hasMinimumSymptomCount 4 ;
    med:hasRequiredDuration "P1D"^^xsd:duration ;
    med:hasSymptom dsm5:Tobacco_Withdrawal_Criterion_B__HP_0000711,
