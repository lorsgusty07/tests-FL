dsm5:Developmental_Coordination_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Developmental Coordination Disorder — Criterion A"@en ;
    med:hasSymptom dsm5:Developmental_Coordination_Disorder_Criterion_A__HP_0011443 ;
    rdfs:comment "The acquisition and execution of coordinated motor skills is substantially below that expected given the individual's chronological age and opportunity for skill learning and use. Difficulties are manifested as clumsiness (e.g., dropping or bumping into objects) as well as slowness and inaccuracy of performance of motor skills (e.g., catching an object, using scissors or cutlery, handwriting, riding a bike, or participating in sports)"@en .

dsm5:Developmental_Coordination_Disorder_Criterion_A__HP_0011443 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Abnormality of coordination"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0011443 ;
    rdfs:comment "The phrase describes difficulties in coordinated motor skills, which aligns with 'Abnormality of coordination'."@en .

dsm5:Developmental_Coordination_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Developmental Coordination Disorder — Criterion B"@en ;
    med:hasSymptom dsm5:Developmental_Coordination_Disorder_Criterion_B__HP_0031058 ;
    rdfs:comment "The motor skills deficit in Criterion A significantly and persistently interferes with activities of daily living appropriate to chronological age (e.g., self-care and self-maintenance) and impacts academic/school productivity, prevocational and vocational activities, leisure, and play"@en .

dsm5:Developmental_Coordination_Disorder_Criterion_B__HP_0031058 a dsm5:Symptom,
        owl:NamedIndividual ;
