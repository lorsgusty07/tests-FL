dsm5:Disruptive_Mood_Dysregulation_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Disruptive Mood Dysregulation Disorder — Criterion D"@en ;
    med:hasSymptom dsm5:Disruptive_Mood_Dysregulation_Disorder_Criterion_D__HP_0031467 ;
