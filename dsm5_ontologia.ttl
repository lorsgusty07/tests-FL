dsm5:Non_Rapid_Eye_Movement_Sleep_Arousal_Disorders_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Non--Rapid Eye Movement Sleep Arousal Disorders — Criterion D"@en ;
