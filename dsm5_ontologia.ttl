    med:mapsToHPO hpo:HP_0002360 ;
    rdfs:comment "The phrase describes a sleep disturbance related to reluctance or refusal to sleep away from home, which aligns with the concept of sleep disturbance."@en .

dsm5:Separation_Anxiety_Disorder_Criterion_A__HP_0025732 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Abnormal social development"@en ;
    dsm5:confidence 0.8 ;
    med:mapsToHPO hpo:HP_0025732 ;
    rdfs:comment "The phrase describes a persistent reluctance or refusal to leave home due to fear, which aligns with abnormal social development."@en .

dsm5:Separation_Anxiety_Disorder_Criterion_A__HP_0031468 a dsm5:Symptom,
