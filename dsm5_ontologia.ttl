        owl:NamedIndividual ;
    rdfs:label "Delusion"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0000746 ;
    rdfs:comment "The term 'Delusion' directly matches the clinical phrase provided."@en .

dsm5:Schizophrenia_Criterion_A__HP_0025769 a dsm5:Symptom,
        owl:NamedIndividual ;
