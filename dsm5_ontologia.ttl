    rdfs:label "Maintenance insomnia"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0031355 ;
    rdfs:comment "Maintenance insomnia is characterized by difficulty staying asleep, which aligns with early-morning awakening and inability to return to sleep."@en .

dsm5:Insomnia_Disorder_Criterion_A__HP_0100785 a dsm5:Symptom,
