dsm5:Intermittent_Explosive_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion A"@en ;
    med:hasRequiredDuration "P1Y"^^xsd:duration ;
    med:hasSymptom dsm5:Intermittent_Explosive_Disorder_Criterion_A__HP_0000718 ;
    rdfs:comment "Recurrent behavioral outbursts representing a failure to control aggressive impulses as manifested by either of the following Verbal aggression (e.g., temper tantrums, tirades, verbal arguments or fights) or physical aggression toward property, animals, or other individuals, occurring twice weekly, on average, for a period of 3 months. The physical aggression does not result in damage or destruction of property and does not result in physical injury to animals or other individuals. Three behavioral outbursts involving damage or destruction of property and/or physical assault involving physical injury against animals or other individuals occurring within a 12-month period."@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_A__HP_0000718 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Aggressive behavior"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0000718 ;
    rdfs:comment "The phrase describes verbal and physical aggression, which aligns with the term 'Aggressive behavior'."@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion B"@en ;
    rdfs:comment "The magnitude of aggressiveness expressed during the recurrent outbursts is grossly out of proportion to the provocation or to any precipitating psychosocial stressors"@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion C"@en ;
    med:hasSymptom dsm5:Intermittent_Explosive_Disorder_Criterion_C__HP_0000734 ;
    rdfs:comment "The recurrent aggressive outbursts are not premeditated (i.e., they are impulsive and/or anger-based) and are not committed to achieve some tangible objective (e.g., money, power, intimidation)"@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_C__HP_0000734 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Disinhibition"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0000734 ;
    rdfs:comment "The phrase describes impulsive and anger-based aggressive outbursts, which aligns with disinhibition."@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion D"@en ;
    med:hasSymptom dsm5:Intermittent_Explosive_Disorder_Criterion_D__HP_0007086 ;
    rdfs:comment "The recurrent aggressive outbursts cause either marked distress in the individual or impairment in occupational or interpersonal functioning, or are associated with financial or legal consequences"@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_D__HP_0007086 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Social and occupational deterioration"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0007086 ;
    rdfs:comment "The phrase describes marked distress or impairment in functioning, which aligns with social and occupational deterioration."@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_E a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion E"@en ;
    rdfs:comment "Chronological age is at least 6 years (or equivalent developmental level)"@en .

dsm5:Intermittent_Explosive_Disorder_Criterion_F a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Intermittent Explosive Disorder — Criterion F"@en ;
    med:hasRequiredDuration "P18Y"^^xsd:duration ;
    rdfs:comment "The recurrent aggressive outbursts are not better explained by another mental disorder (e.g., major depressive disorder, bipolar disorder, disruptive mood dysregulation disorder, a psychotic disorder, antisocial personality disorder, borderline personality disorder) and are not attributable to another medical condition (e.g., head trauma, Alzheimer's disease) or to the physiological effects of a substance (e.g., a drug of abuse, a medication). For children ages 6--18 years, aggressive behavior that occurs as part of an adjustment disorder should not be considered for this diagnosis"@en .

dsm5:Kleptomania_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Kleptomania — Criterion A"@en ;
    rdfs:comment "Recurrent failure to resist impulses to steal objects that are not needed for personal use or for their monetary value"@en .

dsm5:Kleptomania_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Kleptomania — Criterion B"@en ;
