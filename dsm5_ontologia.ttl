    skos:prefLabel "Somatic Symptom Disorder"@en .

dsm5:Specific_Learning_Disorder a owl:Class ;
    rdfs:label "Specific Learning Disorder"@en ;
    med:hasCriterion dsm5:Specific_Learning_Disorder_Criterion_A,
        dsm5:Specific_Learning_Disorder_Criterion_B,
        dsm5:Specific_Learning_Disorder_Criterion_C,
        dsm5:Specific_Learning_Disorder_Criterion_D ;
    med:hasSeverityLevel dsm5:Specific_Learning_Disorder__Severity_0,
        dsm5:Specific_Learning_Disorder__Severity_1,
