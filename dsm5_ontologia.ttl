dsm5:Major_and_Mild_Neurocognitive_Disorders_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Major and Mild Neurocognitive Disorders — Criterion B"@en ;
    rdfs:comment "The cognitive deficits interfere with independence in everyday activities (i.e., at a minimum, requiring assistance with complex instrumental activities of daily living such as paying bills or managing medications)"@en .

dsm5:Major_and_Mild_Neurocognitive_Disorders_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Major and Mild Neurocognitive Disorders — Criterion C"@en ;
    med:hasSymptom dsm5:Major_and_Mild_Neurocognitive_Disorders_Criterion_C__HP_0100543 ;
    rdfs:comment "The cognitive deficits do not occur exclusively in the context of a delirium"@en .

dsm5:Major_and_Mild_Neurocognitive_Disorders_Criterion_C__HP_0100543 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Cognitive impairment"@en ;
