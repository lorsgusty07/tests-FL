        dsm5:Bipolar_II_Disorder_Criterion_C,
        dsm5:Bipolar_II_Disorder_Criterion_D,
        dsm5:Bipolar_II_Disorder_Criterion_E,
        dsm5:Bipolar_II_Disorder_Criterion_F,
        dsm5:Bipolar_II_Disorder_Criterion_G,
        dsm5:Bipolar_II_Disorder_Criterion_H,
        dsm5:Bipolar_II_Disorder_Criterion_I ;
    med:hasSeverityLevel dsm5:Bipolar_II_Disorder__Severity_0,
        dsm5:Bipolar_II_Disorder__Severity_1,
        dsm5:Bipolar_II_Disorder__Severity_2 ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Bipolar II Disorder"@en .

dsm5:Bipolar_I_Disorder a owl:Class ;
    rdfs:label "Bipolar I Disorder"@en ;
    med:hasCriterion dsm5:Bipolar_I_Disorder_Criterion_A,
        dsm5:Bipolar_I_Disorder_Criterion_B,
        dsm5:Bipolar_I_Disorder_Criterion_C,
