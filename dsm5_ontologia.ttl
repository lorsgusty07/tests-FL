dsm5:Adjustment_Disorders_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Adjustment Disorders — Criterion A"@en ;
    med:hasRequiredDuration "P3M"^^xsd:duration ;
    rdfs:comment "The development of emotional or behavioral symptoms in response to an identifiable stressor(s) occurring within 3 months of the onset of the stressor(s)"@en .

dsm5:Adjustment_Disorders_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Adjustment Disorders — Criterion B"@en ;
    med:hasSymptom dsm5:Adjustment_Disorders_Criterion_B__HP_0007086 ;
    rdfs:comment "These symptoms or behaviors are clinically significant, as evidenced by one or both of the following Marked distress that is out of proportion to the severity or intensity of the stressor, taking into account the external context and the cultural factors that might influence symptom severity and presentation. Significant impairment in social, occupational, or other important areas of functioning."@en .

dsm5:Adjustment_Disorders_Criterion_B__HP_0007086 a dsm5:Symptom,
