    rdfs:comment "Cognitive deficits are a form of cognitive impairment, which aligns with the selected HPO term."@en .

dsm5:Major_and_Mild_Neurocognitive_Disorders_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Major and Mild Neurocognitive Disorders — Criterion D"@en ;
    rdfs:comment "The cognitive deficits are not better explained by another mental disorder (e.g., major depressive disorder, schizophrenia)"@en .

