dsm5:Schizophrenia_Criterion_A__HP_0031467 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Dysregulated negative emotional state"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0031467 ;
    rdfs:comment "Dysregulated negative emotional state aligns with the concept of negative symptoms such as diminished emotional expression."@en .

dsm5:Schizophrenia_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion B"@en ;
    med:hasSymptom dsm5:Schizophrenia_Criterion_B__HP_0025479 ;
    rdfs:comment "For a significant portion of the time since the onset of the disturbance, level of functioning in one or more major areas, such as work, interpersonal relations, or self-care, is markedly below the level achieved prior to the onset (or when the onset is in childhood or adolescence, there is failure to achieve expected level of interpersonal, academic, or occupational functioning)"@en .

dsm5:Schizophrenia_Criterion_B__HP_0025479 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Self-neglect"@en ;
    dsm5:confidence 0.8 ;
    med:mapsToHPO hpo:HP_0025479 ;
    rdfs:comment "Self-neglect relates to a marked decline in self-care and functioning, aligning with the described disturbance in functioning."@en .

dsm5:Schizophrenia_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion C"@en ;
    med:hasMinimumSymptomCount 2 ;
    med:hasRequiredDuration "P6M"^^xsd:duration ;
    rdfs:comment "Continuous signs of the disturbance persist for at least 6 months. This 6-month period must include at least 1 month of symptoms (or less if successfully treated) that meet Criterion A (i.e., active-phase symptoms) and may include periods of prodromal or residual symptoms. During these prodromal or residual periods, the signs of the disturbance may be manifested by only negative symptoms or by two or more symptoms listed in Criterion A present in an attenuated form (e.g., odd beliefs, unusual perceptual experiences)"@en .

dsm5:Schizophrenia_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion D"@en ;
    rdfs:comment "Schizoaffective disorder and depressive or bipolar disorder with psychotic features have been ruled out because either 1) no major depressive or manic episodes have occurred concurrently with the active-phase symptoms, or 2) if mood episodes have occurred during active-phase symptoms, they have been present for a minority of the total duration of the active and residual periods of the illness"@en .

dsm5:Schizophrenia_Criterion_E a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion E"@en ;
    rdfs:comment "The disturbance is not attributable to the physiological effects of a substance (e.g., a drug of abuse, a medication) or another medical condition"@en .

dsm5:Schizophrenia_Criterion_F a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion F"@en ;
    med:hasRequiredDuration "P1M"^^xsd:duration ;
    med:hasSymptom dsm5:Schizophrenia_Criterion_F__HP_0000746 ;
    rdfs:comment "If there is a history of autism spectrum disorder or a communication disorder of childhood onset, the additional diagnosis of schizophrenia is made only if prominent delusions or hallucinations, in addition to the other required symptoms of schizophrenia, are also present for at least 1 month (or less if successfully treated)"@en .

dsm5:Schizophrenia_Criterion_F__HP_0000746 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Delusion"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0000746 ;
    rdfs:comment "The phrase mentions prominent delusions as a requirement for the diagnosis of schizophrenia, which directly corresponds to the HPO term for delusion."@en .

