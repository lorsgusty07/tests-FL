dsm5:Stimulant_Use_Disorder a owl:Class ;
    rdfs:label "Stimulant Use Disorder"@en ;
    med:hasCriterion dsm5:Stimulant_Use_Disorder_Criterion_A ;
    med:hasSeverityLevel dsm5:Stimulant_Use_Disorder__Severity_0,
        dsm5:Stimulant_Use_Disorder__Severity_1,
        dsm5:Stimulant_Use_Disorder__Severity_2 ;
    med:hasSpecifierText """"In a controlled environment" applies as a further specifier of
remission if the individual is both in remission and in a controlled
environment (i.e., in early remission in a controlled environment or in
sustained remission in a controlled environment). Examples of these
environments are closely supervised and substance-free jails,
therapeutic communities, and locked hospital units."""@en ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Stimulant Use Disorder"@en .

dsm5:Stimulant_Withdrawal a owl:Class ;
