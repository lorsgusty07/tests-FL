dsm5:Personality_Change_Due_to_Another_Medical_Condition_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Personality Change Due to Another Medical Condition — Criterion D"@en ;
