    med:hasSymptom dsm5:Language_Disorder_Criterion_B__HP_0033695 ;
    rdfs:comment "Language abilities are substantially and quantifiably below those expected for age, resulting in functional limitations in effective communication, social participation, academic achievement, or occupational performance, individually or in any combination"@en .

dsm5:Language_Disorder_Criterion_B__HP_0033695 a dsm5:Symptom,
