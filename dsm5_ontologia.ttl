dsm5:Narcolepsy_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Narcolepsy — Criterion A"@en ;
    med:hasRequiredDuration "P3M"^^xsd:duration ;
    med:hasSymptom dsm5:Narcolepsy_Criterion_A__HP_0006979 ;
    rdfs:comment "Recurrent periods of an irrepressible need to sleep, lapsing into sleep, or napping occurring within the same day. These must have been occurring at least three times per week over the past 3 months"@en .

dsm5:Narcolepsy_Criterion_A__HP_0006979 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Sleep-wake cycle disturbance"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0006979 ;
    rdfs:comment "The phrase describes recurrent sleep episodes, which aligns with sleep-wake cycle disturbances."@en .

dsm5:Narcolepsy_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Narcolepsy — Criterion B"@en ;
    med:hasMinimumSymptomCount 1 ;
    med:hasRequiredDuration "P6M"^^xsd:duration ;
    med:hasSymptom dsm5:Narcolepsy_Criterion_B__HP_0002524,
        dsm5:Narcolepsy_Criterion_B__HP_5200356 ;
    rdfs:comment "The presence of at least one of the following Episodes of cataplexy, defined as either (a) or (b), occurring at least a few times per month: In individuals with long-standing disease, brief (seconds to minutes) episodes of sudden bilateral loss of muscle tone with maintained consciousness that are precipitated by laughter or joking. In children or in individuals within 6 months of onset, spontaneous grimaces or jaw-opening episodes with tongue thrusting or a global hypotonia, without any obvious emotional triggers. Hypocretin deficiency, as measured using cerebrospinal fluid (CSF) hypocretin-1 immunoreactivity values (less than or equal to one-third of values obtained in healthy subjects tested using the same assay, or less than or equal to 110 pg/mL). Low CSF levels of hypocretin-1 must not be observed in the context of acute brain injury, inflammation, or infection. Nocturnal sleep polysomnography showing rapid eye movement (REM) sleep latency less than or equal to 15 minutes, or a multiple sleep latency test showing a mean sleep latency less than or equal to 8 minutes and two or more sleep-onset REM periods."@en .

dsm5:Narcolepsy_Criterion_B__HP_0002524 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Cataplexy"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0002524 ;
    rdfs:comment "The phrase specifically refers to episodes of cataplexy, which directly matches the HPO term for cataplexy."@en .

dsm5:Narcolepsy_Criterion_B__HP_5200356 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Sleep onset rapid eye movement period"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_5200356 ;
    rdfs:comment "The phrase specifically mentions sleep-onset REM periods, which directly corresponds to the HPO term for sleep onset rapid eye movement period."@en .

dsm5:Narcolepsy__Severity_0 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Mild:** Need for naps only once or twice per day. Sleep disturbance,"@en .

dsm5:Narcolepsy__Severity_1 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Moderate:** Need for multiple naps daily. Sleep may be moderately"@en .

dsm5:Narcolepsy__Severity_2 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Severe:** Nearly constant sleepiness and, often, highly disturbed"@en .

dsm5:Nightmare_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Nightmare Disorder — Criterion A"@en ;
    med:hasSymptom dsm5:Nightmare_Disorder_Criterion_A__HP_5200287 ;
    rdfs:comment "Repeated occurrences of extended, extremely dysphoric, and well-remembered dreams that usually involve efforts to avoid threats to survival, security, or physical integrity and that generally occur during the second half of the major sleep episode"@en .

dsm5:Nightmare_Disorder_Criterion_A__HP_5200287 a dsm5:Symptom,
