dsm5:Bipolar_I_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Bipolar I Disorder — Criterion B"@en ;
    med:hasMinimumSymptomCount 3 ;
    med:hasRequiredDuration "PT3H"^^xsd:duration ;
