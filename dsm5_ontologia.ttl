dsm5:Schizoid_Personality_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizoid Personality Disorder — Criterion B"@en ;
    rdfs:comment "Does not occur exclusively during the course of schizophrenia, a bipolar disorder or depressive disorder with psychotic features, another psychotic disorder, or autism spectrum disorder and is not attributable to the physiological effects of another medical condition"@en .

dsm5:Schizophrenia_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophrenia — Criterion A"@en ;
    med:hasMinimumSymptomCount 2 ;
    med:hasRequiredDuration "P1M"^^xsd:duration ;
    med:hasSymptom dsm5:Schizophrenia_Criterion_A__HP_0000738,
        dsm5:Schizophrenia_Criterion_A__HP_0000746,
        dsm5:Schizophrenia_Criterion_A__HP_0025769,
        dsm5:Schizophrenia_Criterion_A__HP_0031467 ;
    rdfs:comment "Two (or more) of the following, each present for a significant portion of time during a 1-month period (or less if successfully treated). At least one of these must be (1), (2), or (3) Delusions. Hallucinations. Disorganized speech (e.g., frequent derailment or incoherence). Grossly disorganized or catatonic behavior. Negative symptoms (i.e., diminished emotional expression or avolition)."@en .

dsm5:Schizophrenia_Criterion_A__HP_0000738 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Hallucinations"@en ;
    dsm5:confidence 1.0 ;
