dsm5:Rapid_Eye_Movement_Sleep_Behavior_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Rapid Eye Movement Sleep Behavior Disorder — Criterion B"@en ;
    rdfs:comment "These behaviors arise during rapid eye movement (REM) sleep and therefore usually occur more than 90 minutes after sleep onset, are more frequent during the later portions of the sleep period, and uncommonly occur during daytime naps"@en .

dsm5:Rapid_Eye_Movement_Sleep_Behavior_Disorder_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Rapid Eye Movement Sleep Behavior Disorder — Criterion C"@en ;
    rdfs:comment "Upon awakening from these episodes, the individual is completely awake, alert, and not confused or disoriented"@en .

dsm5:Rapid_Eye_Movement_Sleep_Behavior_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
