dsm5:Other_Hallucinogen_Use_Disorder_Criterion_A__HP_0030858 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Addictive behavior"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0030858 ;
    rdfs:comment "The phrase describes continued use of hallucinogens despite knowledge of problems likely caused or exacerbated by their use, which aligns with addictive behavior."@en .

dsm5:Other_Hallucinogen_Use_Disorder_Criterion_A__HP_0033511 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Addictive substance use"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0033511 ;
    rdfs:comment "The phrase describes a persistent desire or unsuccessful efforts to control hallucinogen use, which aligns with the concept of addictive substance use."@en .

