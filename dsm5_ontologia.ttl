dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Social (Pragmatic) Communication Disorder — Criterion A"@en ;
    med:hasSymptom dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_0002463,
        dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_5200030,
        dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_5200113 ;
    rdfs:comment "Persistent difficulties in the social use of verbal and nonverbal communication as manifested by all of the following Deficits in using communication for social purposes, such as greeting and sharing information, in a manner that is appropriate for the social context. Impairment of the ability to change communication to match context or the needs of the listener, such as speaking differently in a classroom than on a playground, talking differently to a child than to an adult, and avoiding use of overly formal language. Difficulties following rules for conversation and storytelling, such as taking turns in conversation, rephrasing when misunderstood, and knowing how to use verbal and nonverbal signals to regulate interaction. Difficulties understanding what is not explicitly stated (e.g., making inferences) and nonliteral or ambiguous meanings of language (e.g., idioms, humor, metaphors, multiple meanings that depend on the context for interpretation)."@en .

dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_0002463 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Language impairment"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0002463 ;
    rdfs:comment "The phrase describes impairment in communication that aligns with language impairment, which is best captured by HP:0002463."@en .

dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_5200030 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Diminished integration of verbal and non-verbal communicative behavior"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_5200030 ;
    rdfs:comment "The phrase describes difficulties in communication, which aligns with diminished integration of verbal and non-verbal communicative behavior."@en .

dsm5:Social_Pragmatic_Communication_Disorder_Criterion_A__HP_5200113 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Failure to offer information to initiate social interaction"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_5200113 ;
    rdfs:comment "This term directly relates to the failure to offer information to initiate social interaction, which aligns with the deficits in using communication for social purposes described in the DSM criterion."@en .

dsm5:Social_Pragmatic_Communication_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Social (Pragmatic) Communication Disorder — Criterion B"@en ;
    med:hasSymptom dsm5:Social_Pragmatic_Communication_Disorder_Criterion_B__HP_5200310 ;
    rdfs:comment "The deficits result in functional limitations in effective communication, social participation, social relationships, academic achievement, or occupational performance, individually or in combination"@en .

dsm5:Social_Pragmatic_Communication_Disorder_Criterion_B__HP_5200310 a dsm5:Symptom,
        owl:NamedIndividual ;
