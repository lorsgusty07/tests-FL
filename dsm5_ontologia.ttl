        owl:NamedIndividual ;
    rdfs:label "Social and occupational deterioration"@en ;
    dsm5:confidence 0.9 ;
    med:mapsToHPO hpo:HP_0007086 ;
    rdfs:comment "The phrase describes a reduction in social and occupational activities due to alcohol use, which aligns with social and occupational deterioration."@en .

dsm5:Alcohol_Use_Disorder_Criterion_A__HP_0030955 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Addictive alcohol use"@en ;
    dsm5:confidence 0.9 ;
