        dsm5:Obsessive_Compulsive_Personality_Disorder_Criterion_E,
        dsm5:Obsessive_Compulsive_Personality_Disorder_Criterion_F,
        dsm5:Obsessive_Compulsive_Personality_Disorder_Criterion_G,
        dsm5:Obsessive_Compulsive_Personality_Disorder_Criterion_H ;
    rdfs:subClassOf dsm5:MentalDisorder ;
    skos:prefLabel "Obsessive-Compulsive Personality Disorder"@en .

