    med:hasSymptom dsm5:Major_Depressive_Disorder_Criterion_B__HP_0007086 ;
    rdfs:comment "The symptoms cause clinically significant distress or impairment in social, occupational, or other important areas of functioning"@en .

dsm5:Major_Depressive_Disorder_Criterion_B__HP_0007086 a dsm5:Symptom,
