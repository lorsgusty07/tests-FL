dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition a owl:Class ;
    rdfs:label "Bipolar and Related Disorder Due to Another Medical Condition"@en ;
    med:hasCriterion dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition_Criterion_A,
        dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition_Criterion_B,
        dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition_Criterion_C,
        dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition_Criterion_D,
        dsm5:Bipolar_and_Related_Disorder_Due_to_Another_Medical_Condition_Criterion_E ;
