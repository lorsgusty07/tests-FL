dsm5:Autism_Spectrum_Disorder_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Autism Spectrum Disorder — Criterion C"@en ;
    rdfs:comment "Symptoms must be present in the early developmental period (but may not become fully manifest until social demands exceed limited capacities, or may be masked by learned strategies in later life)"@en .

dsm5:Autism_Spectrum_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Autism Spectrum Disorder — Criterion D"@en ;
    rdfs:comment "Symptoms cause clinically significant impairment in social, occupational, or other important areas of current functioning"@en .

dsm5:Autism_Spectrum_Disorder_Criterion_E a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Autism Spectrum Disorder — Criterion E"@en ;
    rdfs:comment "These disturbances are not better explained by intellectual developmental disorder (intellectual disability) or global developmental delay. Intellectual developmental disorder and autism spectrum disorder frequently co-occur; to make comorbid diagnoses of autism spectrum disorder and intellectual developmental disorder, social communication should be below that expected for general developmental level"@en .

dsm5:Avoidant_Personality_Disorder_Criterion_A a dsm5:DiagnosticCriterion,
