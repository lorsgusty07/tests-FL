dsm5:Nightmare_Disorder__Severity_0 a dsm5:SeverityLevel,
        owl:NamedIndividual ;
    rdfs:label "Mild:** Less than one episode per week on average."@en .

dsm5:Nightmare_Disorder__Severity_1 a dsm5:SeverityLevel,
