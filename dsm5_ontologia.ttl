dsm5:Phencyclidine_Intoxication_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Phencyclidine Intoxication — Criterion C"@en ;
    med:hasMinimumSymptomCount 2 ;
    med:hasRequiredDuration "PT1H"^^xsd:duration ;
    med:hasSymptom dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0000639,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001251,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001260,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001649,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0002063,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0007334,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0010780,
        dsm5:Phencyclidine_Intoxication_Criterion_C__HP_5200213 ;
    rdfs:comment "Within 1 hour, two (or more) of the following signs or symptoms Vertical or horizontal nystagmus. Hypertension or tachycardia. Numbness or diminished responsiveness to pain. Ataxia. Dysarthria. Muscle rigidity. Seizures or coma. Hyperacusis."@en .

dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0000639 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Nystagmus"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0000639 ;
    rdfs:comment "Nystagmus is directly mentioned in the DSM criterion, making this the best match."@en .

dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001251 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Ataxia"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0001251 ;
    rdfs:comment "The term 'Ataxia' directly matches the HPO term for ataxia."@en .

dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001260 a dsm5:Symptom,
        owl:NamedIndividual ;
    rdfs:label "Dysarthria"@en ;
    dsm5:confidence 1.0 ;
    med:mapsToHPO hpo:HP_0001260 ;
    rdfs:comment "Dysarthria directly matches the HPO term for dysarthria."@en .

dsm5:Phencyclidine_Intoxication_Criterion_C__HP_0001649 a dsm5:Symptom,
        owl:NamedIndividual ;
