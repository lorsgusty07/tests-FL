dsm5:Schizophreniform_Disorder_Criterion_B a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophreniform Disorder — Criterion B"@en ;
    med:hasRequiredDuration "P6M"^^xsd:duration ;
    rdfs:comment "An episode of the disorder lasts at least 1 month but less than 6 months. When the diagnosis must be made without waiting for recovery, it should be qualified as \"provisional.\""@en .

dsm5:Schizophreniform_Disorder_Criterion_C a dsm5:DiagnosticCriterion,
        owl:NamedIndividual ;
    rdfs:label "Schizophreniform Disorder — Criterion C"@en ;
    rdfs:comment "Schizoaffective disorder and depressive or bipolar disorder with psychotic features have been ruled out because either 1) no major depressive or manic episodes have occurred concurrently with the active-phase symptoms, or 2) if mood episodes have occurred during active-phase symptoms, they have been present for a minority of the total duration of the active and residual periods of the illness"@en .

dsm5:Schizophreniform_Disorder_Criterion_D a dsm5:DiagnosticCriterion,
